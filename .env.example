# Copy this file to ".env" and fill in your values:   cp .env.example .env
# NEVER commit the real .env file (it is listed in .gitignore).
# Keep exactly ONE line per setting - if a name appears twice, the last one wins.

# ---- Option A: OpenAI (default) ------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_KEY


# ---- Option B: Groq free tier (OpenAI-compatible) ------------------------------
# Get a free key at https://console.groq.com/keys, then use:
#   OPENAI_API_KEY=gsk_your_key
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.1-8b-instant
# (run "python scripts/check_llm.py --list-models" to see the models your key can use)
# OPENAI_BASE_URL=
 
   OPENAI_BASE_URL=https://api.groq.com/openai/v1
   OPENAI_MODEL=llama-3.1-8b-instant
   LLM_TEMPERATURE=0.3
   COMPANY_NAME=XYZ Finance
   DB_PATH=data/complaints.db
# ---- LLM settings ---------------------------------------------------------------
# temperature 0.3 = consistent, professional answers
LLM_TEMPERATURE=0.3

# ---- Branding -------------------------------------------------------------------
COMPANY_NAME=XYZ Finance

# ---- Storage (SQLite) -----------------------------------------------------------
DB_PATH=data/complaints.db

# ---- Optional -------------------------------------------------------------------
# Protect the Support Console with a PIN
# SUPPORT_PIN=1234
# Force the rule-based engine even if a key is set
# OFFLINE_MODE=false
