# Copy this file to ".env" and fill in your values:   cp .env.example .env
# NEVER commit the real .env file (it is listed in .gitignore).
# Keep exactly ONE line per setting - if a name appears twice, the last one wins.

# ---- Which LLM back-end? --------------------------------------------------------
# openai = any OpenAI-compatible API (OpenAI, Groq, ...)   |   ollama = local model
LLM_PROVIDER=openai

# ---- Option A: hosted API (LLM_PROVIDER=openai) ---------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Groq free tier instead (key from https://console.groq.com/keys):
#   OPENAI_API_KEY=gsk_your_key
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-20b
# Models get retired now and then - run "python scripts/check_llm.py --list-models".
# OPENAI_BASE_URL=

# ---- Option B: local model with Ollama (LLM_PROVIDER=ollama) --------------------
# Install Ollama from https://ollama.com, then run:  ollama pull mistral
# OLLAMA_MODEL=mistral
# OLLAMA_BASE_URL=http://localhost:11434

# ---- LLM settings ---------------------------------------------------------------
# temperature 0.3 = consistent, professional answers
LLM_TEMPERATURE=0.3

# ---- Branding -------------------------------------------------------------------
COMPANY_NAME=XYZ Finance

# ---- Storage (SQLite) -----------------------------------------------------------
DB_PATH=data/complaints.db

# ---- Optional -------------------------------------------------------------------
# Protect the Support Console with a PIN
# SUPPORT_PIN=1234
# Force the rule-based engine even if a key is set
# OFFLINE_MODE=false
